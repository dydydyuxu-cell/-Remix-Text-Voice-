# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# API_KEY_ENCRYPTION_SECRET:
# Server-only secret used to encrypt users' Gemini API keys.
# The REAL value must be configured in the server Secrets/Environment settings.
# NEVER put the real secret in GitHub.
API_KEY_ENCRYPTION_SECRET="SET_THIS_IN_SERVER_SECRETS_ONLY"

# IMPORTANT:
# GEMINI_API_KEY is intentionally NOT used as a fallback
# for user TTS requests.
