rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }

    /**
     * Validates the user's balance document.
     *
     * Every balance document belongs exclusively to its
     * Firebase Authentication UID.
     */
    function validBalanceDocument(userId) {
      return isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.freeCharacters == 10000
        && request.resource.data.usedCharacters >= 0
        && request.resource.data.usedCharacters <= 10000
        && request.resource.data.remainingCharacters >= 0
        && request.resource.data.remainingCharacters <= 10000;
    }

    /**
     * Existing balance cannot be manipulated by decreasing
     * usedCharacters.
     *
     * This prevents a client from simply resetting its own
     * used character count back to zero.
     */
    function validBalanceUpdate(userId) {
      return validBalanceDocument(userId)
        && request.resource.data.usedCharacters
           >= resource.data.usedCharacters;
    }

    /**
     * USER DOCUMENTS
     *
     * Every user's data is partitioned by Firebase UID.
     */
    match /users/{userId} {

      /**
       * The user can access their own user document.
       */
      allow read: if isOwner(userId);

      /**
       * Prevent direct arbitrary writes to the parent user
       * document.
       */
      allow write: if false;


      /**
       * USER SETTINGS
       */
      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }


      /**
       * USER USAGE
       */
      match /usage/{docId} {

        /**
         * BALANCE
         *
         * The user may read only their own balance.
         *
         * Creation is limited to the initial 10,000-character
         * allowance.
         *
         * Updates cannot reduce usedCharacters.
         */
        match /balance {
          allow read: if isOwner(userId);

          allow create: if validBalanceDocument(userId)
            && request.resource.data.usedCharacters == 0;

          allow update: if validBalanceUpdate(userId);

          allow delete: if false;
        }

        /**
         * Other usage documents remain isolated by UID.
         */
        allow read, write: if isOwner(userId);
      }


      /**
       * GENERATION HISTORY
       */
      match /generations/{generationId} {
        allow read, write: if isOwner(userId);
      }


      /**
       * Any other subcollection remains isolated by UID.
       */
      match /{subpath=**} {
        allow read, write: if isOwner(userId);
      }
    }


    /**
     * DEFAULT DENY
     *
     * Nothing outside /users/{userId} is accessible.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
